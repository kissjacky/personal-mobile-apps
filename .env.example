# Copy this file to .env for local builds. Do not commit .env.

PROJECT_GRADLE_NAME=PersonalMobileApps

JAVA_HOME=
ANDROID_HOME=
ANDROID_SDK_ROOT=

ANDROID_COMPILE_SDK=28
ANDROID_MIN_SDK=23
ANDROID_TARGET_SDK=28

COMMON_UI_NAMESPACE=com.personalapps.commonui

METRONOME_NAMESPACE=com.personalapps.metronome
METRONOME_APPLICATION_ID=com.personalapps.metronome
METRONOME_VERSION_CODE=14
METRONOME_VERSION_NAME=1.0.13
METRONOME_APK_BASENAME=metronome-android9

GITHUB_OWNER=kissjacky
GITHUB_REPO=personal-mobile-apps

# Gitee is a post-publish mirror. GitHub remains the primary repository.
GITEE_OWNER=jackyyu
GITEE_REPO=personal-mobile-apps

# Release signing is required for installable release APKs.
# Keep these values only in .env locally or in GitHub/Gitee CI secrets.
ANDROID_SIGNING_STORE_FILE=
ANDROID_SIGNING_STORE_PASSWORD=
ANDROID_SIGNING_KEY_ALIAS=
ANDROID_SIGNING_KEY_PASSWORD=

# Gitee Release API token. Only needed by post-sync scripts/CI.
GITEE_ACCESS_TOKEN=
